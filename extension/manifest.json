{
  "manifest_version": 3,
  "name": "VocabClip",
  "version": "0.1.1",
  "description": "Clip English words, save them to Obsidian, and review with spaced repetition.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "nativeMessaging",
    "notifications",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "VocabClip",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "options_page": "options.html"
}
